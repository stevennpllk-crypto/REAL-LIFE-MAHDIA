; REAL-LIFE-MAHDIA — Godot 4 project
config_version=5

[application]
config/name="REAL LIFE: MAHDIA"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/description="A mobile-first open-world life simulation inspired by Mahdia, Tunisia."

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="canvas_items"

[rendering]
limits/opengl/max_lights_per_object=2
limits/opengl/max_renderable_lights=8
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.48, 0.69, 0.86, 1)

[physics]
3d/default_gravity=9.8
