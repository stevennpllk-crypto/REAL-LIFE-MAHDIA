; REAL-LIFE-MAHDIA — Godot 4 project
config_version=5

[application]
config/name="REAL LIFE: MAHDIA"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/description="A mobile-first open-world life simulation inspired by Mahdia, Tunisia."

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
; Main build: Mobile (Vulkan) renderer for real lighting - sun shadows, HDRI sky
; lighting and reflections, ACES tonemapping, glow, fog and the sea shader.
; CI also exports a GL Compatibility APK for older devices (Low tier look).
renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
; Compatibility-only limits. 0 omni/spot slots made GLES3 scene shaders fail to
; compile (zero-sized light arrays); keep a small non-zero budget instead.
limits/opengl/max_lights_per_object=2
limits/opengl/max_renderable_lights=8
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=false
textures/default_filters/anisotropic_filtering_level=3
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
anti_aliasing/quality/msaa_3d=1
occlusion_culling/use_occlusion_culling=true
environment/defaults/default_clear_color=Color(0.48, 0.69, 0.86, 1)

[audio]

general/text_to_speech=true

[physics]
3d/default_gravity=9.8
